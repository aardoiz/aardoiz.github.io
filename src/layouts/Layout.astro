---
import "../styles/global.css";
import license from "../../LICENSE?raw";
interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "Alfonso Ardoiz, Senior AI Engineer and Technical Lead. Explore AI agents, retrieval systems and Python applications, from research to production.",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL("/social-card.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <Fragment set:html={`<!--\n${license}\n-->`} />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101010" />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Alfonso Ardoiz" />
    <meta property="og:image" content={image} />
    <meta
      property="og:image:alt"
      content="Alfonso Ardoiz — AI systems from research to production"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <title>{title}</title>
  </head>
  <body><a class="skip-link" href="#main">Skip to content</a><slot /></body>
</html>
