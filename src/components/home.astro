---
import { profile } from "../content/portfolio";
---

<section id="home" class="hero shell" aria-labelledby="hero-title">
  <div class="hero-grid">
    <div>
      <div class="eyebrow">
        <span class="dot" aria-hidden="true"></span>{profile.role}
      </div>
      <h1 id="hero-title">
        Building <em>AI systems</em>.<br />From research<br />to <em>production.</em>
      </h1>
      <p class="hero-copy">
        I’m Alfonso, a Senior AI Engineer and Technical Lead. I build AI agents,
        retrieval systems and Python applications—from architecture and
        evaluation to deployment.
      </p>
      <div class="actions">
        <a class="button" href="#projects"
          >Explore my work <span class="arrow" aria-hidden="true">↗</span></a
        ><a class="text-link" href="#contact"
          >Get in touch <span aria-hidden="true">↗</span></a
        >
      </div>
      <p class="hero-note mono">Based in Spain | Building AI since 2020</p>
    </div>
    <div
      class="system-art"
      aria-label="How I build AI systems: understand the problem, design and build, evaluate and deliver"
    >
      <div class="art-top mono">
        <span>FROM PROBLEM TO PRODUCT</span><span>MY APPROACH</span>
      </div>
      <div class="art-question">
        <small>Start with a real need</small>“How can AI make this workflow more
        useful?”
      </div>
      <div class="art-connector" aria-hidden="true"></div>
      <div class="art-nodes">
        <div class="art-node">
          <span class="mono">01</span><b>Understand the problem</b><small
            >User needs · constraints · success criteria</small
          >
        </div>
        <div class="art-node">
          <span class="mono">02</span><b>Design & build</b><small
            >Retrieval · agents · software engineering</small
          >
        </div>
        <div class="art-node">
          <span class="mono">03</span><b>Evaluate & deliver</b><small
            >Quality · observability · deployment</small
          >
        </div>
      </div><div class="art-connector" aria-hidden="true"></div>
      <div class="art-output">
        <span class="mono">A system people can use</span><div
          class="output-items"
        >
          <span>Reliable outputs</span><span>Measurable quality</span><span
            >Clear limitations</span
          >
        </div>
      </div>
      <p class="art-footer">
        How I build AI systems · From requirements to delivery
      </p>
    </div>
  </div>
  <div class="credentials">
    <div class="credential">
      <strong>6+ years</strong><span>Building AI systems<br />in Python</span>
    </div>
    <div class="credential">
      <strong>15+</strong><span
        >Production-grade AI solutions<br />across my professional career</span
      >
    </div>
  </div>
</section>
