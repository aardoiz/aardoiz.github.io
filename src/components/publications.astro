---
import { Image } from "astro:assets";
import { publications } from "../content/portfolio";
import { publicationPreviews } from "../content/media";
const descriptions: Record<string, string> = {
  "2024-discharge":
    "MELENDI uses patient discharge summaries to recommend relevant scientific articles, applying information retrieval to clinical language.",
};
const renderDescription = (href: string) =>
  ({
    "https://www.sciencedirect.com/science/article/pii/S0952197624011862":
      descriptions["2024-discharge"],
    "https://arxiv.org/abs/2403.03538":
      "RADIA combines speech recognition and NLP text classification to detect radio advertisements, including new and unscripted ad content.",
    "https://arxiv.org/abs/2302.12746":
      "A study of GPT-3 for generating a free Spanish dictionary, examining language models as a tool for building and evaluating lexical resources.",
    "https://arxiv.org/abs/2302.06426":
      "An empirical study of how ChatGPT handles linguistic ambiguity, examining model strengths, limitations and implications for language model use.",
    "https://aclanthology.org/2022.smm4h-1.3/":
      "Hybrid NLP systems combining deep learning, linguistic rules and medical ontologies for classification and entity detection in Spanish health-related text.",
    "https://aclanthology.org/2022.semeval-1.7/":
      "A reverse dictionary study examining dataset quality and the relationship between definitions and word representations through a lexicographic lens.",
  })[href];
---

<section
  id="publications"
  class="section shell"
  aria-labelledby="research-title"
>
  <div class="section-heading">
    <div>
      <div class="eyebrow">Research & publications</div><h2 id="research-title">
        Publications
      </h2>
    </div><p>
      My research connects information retrieval, natural language processing
      and language model evaluation with practical AI engineering.
    </p>
  </div>
  <p class="research-note">
    My current PhD research focuses on multimodal information retrieval,
    vision-language models and evaluation. Explore selected publications and
    preprints below.
  </p>
  <div class="publication-list">
    {
      publications.slice(0, 2).map((paper) => (
        <article class="publication-card">
          <a
            class="publication-cover"
            href={paper.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Read ${paper.title}`}
          >
            <Image
              src={publicationPreviews[paper.href]}
              alt={`First-page preview of ${paper.title}`}
              widths={[240, 480, 720]}
              sizes="(max-width: 700px) calc(100vw - 100px), 300px"
              loading="lazy"
            />
          </a>
          <div class="publication-content">
            <>
              <div class="publication-title-row">
                <>
                  <h3>
                    <a
                      href={paper.href}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {paper.title}
                    </a>
                  </h3>
                  <span class="project-status">{paper.status}</span>
                </>
              </div>
              <p class="publication-venue">
                {paper.venue} · {paper.year}
              </p>
              <p>{renderDescription(paper.href)}</p>
              <a
                class="text-link"
                href={paper.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                Read paper <span aria-hidden="true">↗</span>
              </a>
            </>
          </div>
        </article>
      ))
    }
  </div>
  <details class="more-papers">
    <summary>More publications and preprints</summary><div
      class="publication-list"
    >
      {
        publications.slice(2).map((paper) => (
          <article class="publication-card">
            <a
              class="publication-cover"
              href={paper.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Read ${paper.title}`}
            >
              <Image
                src={publicationPreviews[paper.href]}
                alt={`First-page preview of ${paper.title}`}
                widths={[240, 480, 720]}
                sizes="(max-width: 700px) calc(100vw - 100px), 300px"
                loading="lazy"
              />
            </a>
            <div class="publication-content">
              <>
                <div class="publication-title-row">
                  <>
                    <h3>
                      <a
                        href={paper.href}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {paper.title}
                      </a>
                    </h3>
                    <span class="project-status">{paper.status}</span>
                  </>
                </div>
                <p class="publication-venue">
                  {paper.venue} · {paper.year}
                </p>
                <p>{renderDescription(paper.href)}</p>
                <a
                  class="text-link"
                  href={paper.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Read paper <span aria-hidden="true">↗</span>
                </a>
              </>
            </div>
          </article>
        ))
      }
    </div>
  </details>
</section>
