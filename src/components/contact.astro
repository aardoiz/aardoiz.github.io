---
import { profile } from "../content/portfolio";
---

<section id="contact" class="contact shell" aria-labelledby="contact-title">
  <div class="contact-box">
    <div>
      <div class="eyebrow"><span>04 / WHAT’S NEXT</span></div>
      <h2 id="contact-title">Let’s build your next AI product.</h2>
      <p>
        I’m open to Senior AI Engineer and Technical Lead roles. If your team
        needs someone to own architecture, build the system and guide it through
        evaluation and delivery, let’s talk.
      </p>
    </div>
    <div class="contact-links">
      <a class="contact-email" href={`mailto:${profile.email}`}
        >{profile.email}<span class="arrow" aria-hidden="true">↗</span></a
      >
      <div class="contact-socials">
        <a href={profile.linkedin} target="_blank" rel="noopener noreferrer"
          >LinkedIn ↗</a
        >
        <a href={profile.github} target="_blank" rel="noopener noreferrer"
          >GitHub ↗</a
        >
      </div><p class="contact-location">{profile.location}</p>
    </div>
  </div>
</section>
