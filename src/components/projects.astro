---
import { projects } from "../content/portfolio";
import ProjectPreview from "./projectPreview.astro";
const featured = projects[0];
---

<section id="projects" class="section shell" aria-labelledby="work-title">
  <div class="section-heading">
    <div>
      <div class="eyebrow">
        <span class="index">01 /</span> Selected work
      </div><h2 id="work-title">Selected AI Engineering Projects</h2>
    </div><p>
      Independent AI applications and professional case studies. What I built,
      the engineering decisions behind it and the results.
    </p>
  </div>
  <article class="feature">
    <div class="feature-copy">
      <span class="mono muted">{featured.category}</span><h3>
        {featured.title}
      </h3><p>{featured.summary}</p><div class="chips">
        {
          ["AI agents", "Data provenance", "Isolated Python"].map((tag) => (
            <span class="chip">{tag}</span>
          ))
        }
      </div><a class="text-link" href={`/work/${featured.slug}/`}
        >Explore the case study <span class="arrow" aria-hidden="true">↗</span
        ></a
      >
    </div>
    <a
      class="feature-preview project-cover-link"
      href={`/work/${featured.slug}/`}
      aria-label={`Explore ${featured.title}`}
      ><ProjectPreview slug={featured.slug} title={featured.title} /></a
    >
  </article>
  <div class="project-grid">
    {
      projects.slice(1).map((project) => (
        <article class="project-card">
          <a
            class="project-cover-link"
            href={`/work/${project.slug}/`}
            aria-label={`Explore ${project.title}`}
          >
            <ProjectPreview slug={project.slug} title={project.title} />
          </a>
          <div class="project-card-content">
            <>
              <span class="card-category mono">{project.category}</span>
              <h3>{project.title}</h3>
              <p>{project.summary}</p>
              <div class="chips">
                {project.stack.slice(0, 3).map((tag) => (
                  <span class="chip">{tag}</span>
                ))}
              </div>
              <a class="text-link" href={`/work/${project.slug}/`}>
                Read the case study{" "}
                <span class="arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
            </>
          </div>
        </article>
      ))
    }
  </div>
</section>
