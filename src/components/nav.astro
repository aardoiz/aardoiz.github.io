---
const isHome = Astro.url.pathname === "/";
const anchor = (id: string) => `${isHome ? "" : "/"}#${id}`;
---

<header class="shell">
  <nav class="nav" aria-label="Main navigation">
    <a class="brand" href="/" aria-label="Alfonso Ardoiz, home"
      ><span class="brand-mark" aria-hidden="true">aa</span>Alfonso Ardoiz<span
        class="blue"
        aria-hidden="true">.</span
      ></a
    >
    <div class="nav-links">
      <a href={anchor("projects")}>Work</a><a href={anchor("about")}>About</a><a
        class="nav-research"
        href={anchor("publications")}>Research</a
      ><a class="nav-contact" href={anchor("contact")}
        >Let’s talk <span class="arrow" aria-hidden="true">↗</span></a>
    </div>
  </nav>
</header>
