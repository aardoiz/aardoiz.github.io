---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/nav.astro";
import Contact from "../../components/contact.astro";
import Footer from "../../components/footer.astro";
import ProjectPreview from "../../components/projectPreview.astro";
import { projects, type Project } from "../../content/portfolio";
export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}
interface Props {
  project: Project;
}
const { project } = Astro.props;
const next =
  projects[
    (projects.findIndex((p) => p.slug === project.slug) + 1) % projects.length
  ];
---

<Layout
  title={`${project.title} — Alfonso Ardoiz`}
  description={project.seoDescription}
>
  <Nav />
  <main id="main">
    <article class="shell">
      <header class="case-hero">
        <a class="text-link back-link" href="/#projects"
          ><span aria-hidden="true">←</span> All selected work</a
        >
        <div class="eyebrow">
          <span class="index">{project.number} /</span>{project.category}
        </div>
        <h1>{project.headline}</h1><p class="case-summary">{project.summary}</p>
        <div class="case-meta">
          <div>
            <span class="mono muted">MY ROLE</span><p>{project.role}</p>
          </div><div>
            <span class="mono muted">TOOLS & APPROACHES</span><div
              class="chips"
            >
              {project.stack.map((tag) => <span class="chip">{tag}</span>)}
            </div>
          </div>
        </div>
        {
          project.links.some((link) => link.availability === "pending") && (
            <div class="availability">
              <>
                <span class="mono">Public demo & repository</span>
                <p>
                  Public release planned. The demo will let you explore saved
                  analyses from actual NBA queries, including charts, source
                  data and methodology.
                </p>
              </>
            </div>
          )
        }
        <div class="actions">
          {
            project.links
              .filter((link) => link.availability === "available")
              .map((link) => (
                <a
                  class="text-link"
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {link.label} ↗
                </a>
              ))
          }
        </div>
      </header>
      <ProjectPreview slug={project.slug} title={project.title} />
      <section class="case-section" aria-labelledby="problem-title">
        <h2 id="problem-title">The problem</h2><div class="case-body">
          <p>{project.problem}</p>
        </div>
      </section>
      <section class="case-section" aria-labelledby="ownership-title">
        <h2 id="ownership-title">My contribution</h2><div class="case-body">
          <p>{project.contribution}</p>
        </div>
      </section>
      <section class="case-section" aria-labelledby="architecture-title">
        <h2 id="architecture-title">System workflow</h2><div>
          <ol class="flow">
            {
              project.flow.map((step, i) => (
                <li>
                  <>
                    <span class="mono">{String(i + 1).padStart(2, "0")} →</span>
                    <h3>{step.name}</h3>
                    <p>{step.detail}</p>
                  </>
                </li>
              ))
            }
          </ol>
          <p class="diagram-caption">
            Workflow overview, from input to output.
          </p>
        </div>
      </section>
      <section class="case-section" aria-labelledby="decisions-title">
        <h2 id="decisions-title">Engineering decisions</h2><div>
          {
            project.decisions.map((decision) => (
              <div class="decision">
                <>
                  <h3>{decision.title}</h3>
                  <p>{decision.description}</p>
                </>
              </div>
            ))
          }
        </div>
      </section>
      <section class="case-section" aria-labelledby="results-title">
        <h2 id="results-title">Results</h2><div>
          <ul class="results">
            {project.results.map((result) => <li>{result}</li>)}
          </ul>
        </div>
      </section>
      <section class="case-section" aria-labelledby="evaluation-title">
        <h2 id="evaluation-title">Evaluation</h2><div class="case-body">
          <p>{project.evaluation}</p>
        </div>
      </section>
      <section class="case-section" aria-labelledby="limitations-title">
        <h2 id="limitations-title">Project context & limitations</h2><div
          class="case-body"
        >
          <p>{project.limitations}</p>
        </div>
      </section>
      <a class="case-next" href={`/work/${next.slug}/`}
        ><div>
          <span class="mono muted">NEXT CASE STUDY</span><h2>{next.title}</h2>
        </div><span class="arrow" aria-hidden="true">↗</span></a
      >
    </article>
    <Contact />
  </main><Footer />
</Layout>
